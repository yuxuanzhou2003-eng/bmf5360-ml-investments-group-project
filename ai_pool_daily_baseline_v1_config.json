    "C": 1.0,
    "max_iter": 2000,
    "solver": "lbfgs",
    "random_state": 5360
  },
  "random_forest": {
    "n_estimators": 500,
    "max_depth": 4,
    "min_samples_leaf": 100,
    "max_features": "sqrt",
    "class_weight": "balanced",
    "random_state": 5360,
    "n_jobs": -1
  },
  "walk_forward": {
    "policy": "Fit once on non-overlapping training anchors through 2020-12-31, then score validation anchors in chronological date order without random mixing or validation-label refit.",
    "boundary_embargo_sessions": 21
  },
  "test_policy": "Do not read, aggregate, score, rank, predict, or inspect any test-period future return. Save validation predictions only."
}
